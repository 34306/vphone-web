# vphone-web configuration — copy to `.env` and edit. Never commit your real `.env`.
# Loaded by the Makefile (`make web_run`) and honored by web/app/config.py.

# ---- Paths into the vphone-cli submodule (built there) ----
# The signed vphone-cli binary (built inside vendor/vphone-cli via `make build`).
# App bundle is preferred (it bundles the IPA signing cert).
VPHONE_BIN=vendor/vphone-cli/.build/vphone-cli.app/Contents/MacOS/vphone-cli

# Golden base VM(s) you create with vphone-cli. Point each iOS version at its base
# directory (the folder that contains Disk.img, nvram.bin, SEPStorage, config.plist,
# AVPBooter*.bin, .vphoned.signed). Only versions whose Disk.img exists are offered.
VPHONE_BASE_VM=vendor/vphone-cli/vm
# VPHONE_BASE_VM_265=vendor/vphone-cli/vm-26.5
# VPHONE_BASE_VM_27=vendor/vphone-cli/vm-27
VPHONE_DEFAULT_IOS=26.1

# Where per-VM copy-on-write clones are stored (created at runtime).
VPHONE_VMS_DIR=vms

# Where the SQLite DB + session secret live (created at runtime; gitignored).
VPHONE_DATA_DIR=web/data

# ---- Web server bind ----
VPHONE_HOST=127.0.0.1
VPHONE_PORT=8080

# ---- Resource limits ----
VPHONE_DEFAULT_CPU=4
VPHONE_DEFAULT_MEM_MB=4096
# Refuse to start a VM if total running memory would exceed this (MB).
VPHONE_RAM_BUDGET_MB=12288

# Firmware variant used when booting VMs (regular | dev | jb | exp | less).
VPHONE_VARIANT=regular

# ---- Optional admin auto-seed at startup (only if no admin exists yet) ----
# VPHONE_ADMIN_USER=admin
# VPHONE_ADMIN_PASS=change-me

# Username that can never be demoted/deleted from the UI (lockout guard). Empty = none.
# VPHONE_PROTECTED_ADMIN=admin

# ---- Behind a reverse proxy / Cloudflare Tunnel (optional) ----
# Parent cookie domain so the session cookie is shared across subdomains
# (e.g. ".example.com" so logs.example.com is authorized after login on example.com).
# Leave empty for plain 127.0.0.1 usage.
# VPHONE_COOKIE_DOMAIN=.example.com
