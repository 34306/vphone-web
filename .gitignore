*.ipsw
*.tar
*.tar.gz
*.tar.zst
.vphoned.signed

# --- Local env / secrets ---
.env
.env.local
*.pem
kcpassword

# --- Cloudflare tunnel credentials (never commit) ---
.cloudflared/
*.cloudflared.json

# --- macOS / editors ---
.DS_Store
.idea/
.vscode/
